SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
JWT_SECRET=your-jwt-secret-min-32-chars
NODE_ENV=development
PORT=3001
CORS_ORIGIN=http://localhost:3000
RESEND_API_KEY=re_xxxxxxxx
EMAIL_FROM=Nómadas Tours <onboarding@resend.dev>
FRONTEND_URL=http://localhost:3000
# OPS-EMAIL-001 — temporary Resend recipient gate (default: normal)
# EMAIL_DELIVERY_MODE=normal|restricted|disabled
EMAIL_DELIVERY_MODE=normal
# CSV allowlist when MODE=restricted (empty = fail-safe: skip all)
EMAIL_ALLOWED_RECIPIENTS=
# When true, ticket email is sent by outbox worker
EMAIL_VIA_OUTBOX=false
# false keeps legacy trip lifecycle effects; true enables outbox wiring in a later phase
TRIP_EFFECTS_VIA_OUTBOX=false
# WKR-008 — reminder scheduler + fanout (default false until soak/audit)
TRIP_REMINDER_VIA_OUTBOX=false
# Reminder scheduler poll interval (ms). Default 1h — windows last 24h.
REMINDER_SCHEDULE_POLL_MS=3600000
# Max trips scanned per schedule_trip_reminders call
REMINDER_SCHEDULE_BATCH=50
# WKR-009 — retention purge of completed outbox rows (default false until soak)
OUTBOX_RETENTION_VIA_WORKER=false
# Retention scheduler poll interval (ms). Default 24h.
OUTBOX_RETENTION_POLL_MS=86400000
# Max rows deleted per purge_completed_outbox_events call (RPC hard-caps at 1000)
OUTBOX_RETENTION_BATCH=1000
# Retention age in days (RPC clamps to >= 30)
OUTBOX_RETENTION_DAYS=30
